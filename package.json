{
  "name": "auto-rename-for-perplexity",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 extension that auto-renames new Perplexity chats, regenerates open chat titles, and batch-renames library history.",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.js",
    "zip": "node build.mjs && cd extension && zip -r ../auto-rename-for-perplexity-v0.2.0.zip . -x '*.DS_Store'",
    "seo": "node scripts/build-seo.mjs",
    "site": "node serve-docs.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0"
  }
}
